{
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,
    "paths": {
      "@generale/types": ["./packages/types/src/index.ts"],
      "@generale/bomberman-engine": ["./packages/bomberman-engine/src/index.ts"],
      "@generale/bomberman-engine/dist/*": ["./packages/bomberman-engine/src/*"],
      "@generale/types/dist/*": ["./packages/types/src/*"],
      "~/*": ["./packages/frontend/src/*"]
    }
  },
  "include": [
    "packages/backend/src/**/*.ts",
    "packages/frontend/src/**/*.ts",
    "packages/frontend/src/**/*.tsx",
    "packages/types/src/**/*.ts",
    "packages/bomberman-engine/src/**/*.ts"
  ],
  "exclude": [
    "**/__tests__/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "node_modules"
  ]
}
