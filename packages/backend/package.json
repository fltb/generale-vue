{
  "name": "@generale/backend",
  "version": "1.0.50",
  "private": true,
  "type": "module",
  "scripts": {
    "test:unit": "vitest run",
    "test:integration": "bun test --isolate --max-concurrency=1 src/__tests__/helpers/integration.test.ts src/__tests__/routes/auth.integration.test.ts src/__tests__/routes/game.integration.test.ts src/__tests__/routes/map.integration.test.ts src/__tests__/routes/settings.integration.test.ts",
    "test": "bun run test:unit && bun run test:integration",
    "test:watch": "vitest --watch",
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "typecheck": "npx tsc --noEmit"
  },
  "dependencies": {
    "@elysiajs/cors": "latest",
    "@elysiajs/static": "^1.4.10",
    "@elysiajs/swagger": "latest",
    "@generale/bomberman-engine": "workspace:*",
    "@generale/i18n": "workspace:*",
    "@generale/types": "workspace:*",
    "@libsql/client": "^0.15.15",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "elysia": "latest",
    "elysia-rate-limit": "4.6.2",
    "fast-json-patch": "^3.1.1",
    "nodemailer": "^9.0.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/nodemailer": "^6.4.24",
    "@types/ws": "^8.18.1",
    "bun-types": "latest",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.1",
    "@vitest/coverage-v8": "^3.2.7",
    "vitest": "^3.2.7",
    "ws": "^8.21.1"
  },
  "module": "src/index.js"
}
