{
  "name": "generale-game-monorepo",
  "module": "index.ts",
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@nielspeter/ts-archunit": "^0.17.0",
    "@types/bun": "^1.3.14",
    "dependency-cruiser": "^18.1.0",
    "plop": "^4.0.5"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  },
  "private": true,
  "scripts": {
    "build": "bun run --filter=./packages/* build",
    "dev": "bun run --filter=./packages/* dev",
    "test": "bun run --filter=./packages/* test",
    "test:e2e": "bun run --cwd e2e test",
    "typecheck": "bun run --filter=./packages/* typecheck",
    "lint": "bunx biome lint",
    "format": "bunx biome format --write",
    "check": "bunx biome check",
    "check:write": "bunx biome check --write",
    "ci:lint": "bunx biome ci --reporter=github",
    "check:conventions": "bun run scripts/check-conventions.ts",
    "check:architecture": "depcruise packages/frontend/src packages/backend/src --config .dependency-cruiser.cjs",
    "arch": "bunx ts-archunit check",
    "arch:baseline": "bunx ts-archunit baseline"
  },
  "type": "module",
  "workspaces": [
    "packages/*",
    "e2e"
  ]
}
